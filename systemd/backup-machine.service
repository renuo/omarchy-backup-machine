[Unit]
Description=Back up the whole system to the office NAS
Documentation=https://github.com/renuo/omarchy-backup-machine
ConditionPathExists=/etc/backup-machine/backup.env
ConditionPathExists=/etc/backup-machine/nas.env
ConditionPathExists=/etc/backup-machine/password

[Service]
Type=oneshot
StateDirectory=backup-machine
CacheDirectory=backup-machine
Environment=RESTIC_PASSWORD_FILE=/etc/backup-machine/password
Environment=RESTIC_CACHE_DIR=%C/backup-machine
EnvironmentFile=/etc/backup-machine/backup.env
EnvironmentFile=/etc/backup-machine/nas.env
# Away from the office the NAS does not answer; that skips the run instead of
# failing it.
ExecCondition=/usr/bin/timeout 3 /usr/bin/bash -c 'exec 3<>"/dev/tcp/$${RCLONE_SMB_HOST}/445"'
ExecStart=/usr/local/lib/backup-machine/run
# systemd forgets a run when it restarts, so the outcome is kept for the
# panel. $$ hands a variable to the shell instead of to systemd.
ExecStopPost=/bin/sh -c 'echo "$$SERVICE_RESULT $$(date +%%s)" >"$$STATE_DIRECTORY/last-run"; [ "$$SERVICE_RESULT" != success ] || { cp "$$STATE_DIRECTORY/last-run" "$$STATE_DIRECTORY/last-success"; printf %%s "$$RESTIC_REPOSITORY" >"$$STATE_DIRECTORY/repository"; }'
Nice=10
IOSchedulingClass=idle
