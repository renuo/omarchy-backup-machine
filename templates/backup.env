# Settings of backup-machine.service, read by systemd as they are: one KEY=value
# per line, no shell. The NAS login is in nas.env next to this file, the
# encryption password in password; both are readable by root only.

# The NAS from 1Password's "[Renuo-NAS] Backup User" entry. The panel's
# "Connect" sets it.
RCLONE_SMB_HOST=@HOST@

# The share, then one folder per laptop.
RESTIC_REPOSITORY=rclone::smb:@SHARE@/@HOSTNAME@

# The btrfs subvolumes to snapshot and back up, by mount point. In the backup,
# / is /.backup-machine/root and /home is /.backup-machine/home.
BACKUP_MACHINE_SUBVOLUMES=/ /home

# More options for restic backup. What to leave out is in excludes.txt.
BACKUP_MACHINE_ARGS=--exclude-caches

# Which snapshots to keep: a week of days, a month of weeks, half a year of
# months. The others are deleted after each backup.
RESTIC_FORGET_ARGS=--keep-daily 7 --keep-weekly 4 --keep-monthly 6

# Space the backups may take on the NAS, in GB. The panel warns above it.
BACKUP_MACHINE_QUOTA_GB=2000
