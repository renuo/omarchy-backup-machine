#!/bin/bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if command -v omarchy-plugin-validate >/dev/null 2>&1; then
  omarchy-plugin-validate .
fi

shellcheck ctl.sh libexec/run bin/* test/fakebin/*
# verify wants ExecStart to exist, and the run script lands in /usr/local/lib
# only on install.
unit_dir=$(mktemp -d)
trap 'rm -rf "$unit_dir"' EXIT
sed "s|^ExecStart=/usr/local/lib/backup-machine/run$|ExecStart=$PWD/libexec/run|" systemd/backup-machine.service >"$unit_dir/backup-machine.service"
cp systemd/backup-machine.timer "$unit_dir/"
systemd-analyze verify --man=no "$unit_dir/backup-machine.service" "$unit_dir/backup-machine.timer"

node --test \
  --experimental-test-coverage \
  --test-coverage-include='Model.js' \
  --test-coverage-lines=100 \
  test/*.test.js

bats test/
