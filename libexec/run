#!/bin/bash

# Run by backup-machine.service as root. Takes a read-only btrfs snapshot of every
# subvolume in BACKUP_MACHINE_SUBVOLUMES, so the backup is one moment of the whole
# system, and backs the snapshots up with restic. The settings come from the
# unit's environment files.

set -euo pipefail

SNAPSHOT_DIR=${BACKUP_MACHINE_SNAPSHOT_DIR:-/.backup-machine}
STATE_DIR=${STATE_DIRECTORY:-/var/lib/backup-machine}

# "/" is "root", "/home" is "home", "/var/lib/x" is "var-lib-x".
snapshot_name() {
  local name=${1#/}
  name=${name//\//-}
  printf '%s' "${name:-root}"
}

delete_snapshots() {
  local snapshot
  shopt -s nullglob
  for snapshot in "$SNAPSHOT_DIR"/*; do
    btrfs subvolume delete --commit-after "$snapshot" >/dev/null
  done
  shopt -u nullglob
}

# A snapshot only exists for the run; one left behind by a crash goes first.
trap delete_snapshots EXIT
mkdir -p "$SNAPSHOT_DIR"
delete_snapshots

paths=()
for subvolume in ${BACKUP_MACHINE_SUBVOLUMES:-/ /home}; do
  [[ $(stat -f -c %T "$subvolume") == btrfs ]] || {
    echo "$subvolume is not on btrfs; only btrfs can be snapshotted." >&2
    exit 1
  }
  target="$SNAPSHOT_DIR/$(snapshot_name "$subvolume")"
  btrfs subvolume snapshot -r "$subvolume" "$target" >/dev/null
  paths+=("$target")
done

# shellcheck disable=SC2086 # the options are a list of words
restic backup "${paths[@]}" \
  --exclude-file=/etc/backup-machine/excludes.txt \
  ${BACKUP_MACHINE_ARGS:-}

# shellcheck disable=SC2086 # the options are a list of words
restic forget --prune ${RESTIC_FORGET_ARGS:-}

restic stats --mode raw-data --json >"$STATE_DIR/stats.json.new"
mv "$STATE_DIR/stats.json.new" "$STATE_DIR/stats.json"
